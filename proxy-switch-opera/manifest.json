{
  "manifest_version": 3,
  "name": "Proxy Switch",
  "version": "1.0.0",
  "description": "One-click HTTP / SOCKS5 proxy switch.",
  "minimum_chrome_version": "110",
  "permissions": ["proxy", "storage"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Proxy Switch (off)",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  }
}
